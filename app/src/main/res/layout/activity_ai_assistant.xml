<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    tools:context=".AiAssistantActivity">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_ai_bot"
                android:contentDescription="AI" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/sora_bold"
                android:text="Socialix AI"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnClearChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/sora_regular"
            android:text="Clear"
            android:textColor="#6B6282"
            android:textSize="13sp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/bottomInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNav"
        android:background="#120D24"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <EditText
            android:id="@+id/etPromptInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card_dark"
            android:fontFamily="@font/sora_regular"
            android:hint="Ask Socialix AI anything..."
            android:paddingHorizontal="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6B6282"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/btnSendPrompt"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_fab_gradient">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_send"
                android:contentDescription="Send" />
        </FrameLayout>
    </LinearLayout>

    <!-- Scrollable Chat Messages Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomInputBar"
        android:layout_below="@id/topBar"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <!-- Suggested Prompt Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/promptChip1"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_ai_chip_dark"
                        android:fontFamily="@font/sora_semibold"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Viral Caption"
                        android:textColor="#38BDF8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/promptChip2"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ai_chip_dark"
                        android:fontFamily="@font/sora_semibold"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="# 10 Best Hashtags"
                        android:textColor="#A855F7"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/promptChip3"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ai_chip_dark"
                        android:fontFamily="@font/sora_semibold"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Fix Tone"
                        android:textColor="#EC4899"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Sample Message 1: AI Welcome Bubble -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:background="@drawable/bg_ai_bubble"
                    android:maxWidth="300dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_regular"
                        android:text="Hello Satyam!I'm your AI Social Media Assistant. I can write viral captions, generate hashtag strategies, or optimize your scheduling times. What are we posting today?"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sample Message 2: User Message Bubble -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_user_bubble"
                    android:maxWidth="280dp"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_regular"
                        android:text="Write a short LinkedIn post announcing the launch of our new app Socialix."
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sample Message 3: AI Response Bubble with Action Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:background="@drawable/bg_ai_bubble"
                    android:maxWidth="310dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_regular"
                        android:text=" Big news! Today we are introducing Socialix — your all-in-one social media command center.\n\nDesigned to automate scheduling, analyze reach, and generate content effortlessly.\n\nCheck it out and let us know what you think! 💬"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <!-- Quick Action Chips Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnCopySample"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_ai_chip_dark"
                            android:fontFamily="@font/sora_semibold"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text=" Copy"
                            android:textColor="#B9B2C9"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnUseInPost"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_ai_chip_dark"
                            android:fontFamily="@font/sora_semibold"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text=" Use in Post"
                            android:textColor="#A855F7"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/sora_regular"
                android:text="Home"
                android:textColor="#6B6282"
                android:textSize="10sp" />
        </LinearLayout>

        <!--  Calendar -->
        <LinearLayout
            android:id="@+id/tabCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_calender"
                android:contentDescription="Calendar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/sora_regular"
                android:text="Calendar"
                android:textColor="#6B6282"
                android:textSize="10sp" />
        </LinearLayout>

        <!--  Create Center Button -->
        <FrameLayout
            android:id="@+id/tabCreatePost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_fab_gradient"
                android:contentDescription="Create Post"
                android:padding="10dp"
                android:src="@drawable/ic_nav_add" />
        </FrameLayout>

        <!-- Analytics -->
        <LinearLayout
            android:id="@+id/tabAnalytics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_analytics"
                android:contentDescription="Analytics" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/sora_regular"
                android:text="Analytics"
                android:textColor="#6B6282"
                android:textSize="10sp" />
        </LinearLayout>

        <!--  Profile -->
        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_profile"
                android:contentDescription="Profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/sora_regular"
                android:text="Profile"
                android:textColor="#6B6282"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>