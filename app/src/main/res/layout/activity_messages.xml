<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    tools:context=".MessagesActivity">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/sora_bold"
            android:text="Messages"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
    </RelativeLayout>

    <!-- Scrollable Main Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/topBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Comments vs DMs Segmented Switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_segmented_container"
                android:padding="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabComments"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_active"
                    android:gravity="center"
                    android:fontFamily="@font/sora_semibold"
                    android:text="Comments"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tabDMs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:fontFamily="@font/sora_regular"
                    android:text="DMs"
                    android:textColor="#B9B2C9"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Filter Chips Row (All, Unread, Replied) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_filter_active"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:fontFamily="@font/sora_semibold"
                    android:text="All"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipUnread"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:fontFamily="@font/sora_regular"
                    android:text="Unread"
                    android:textColor="#B9B2C9"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipReplied"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_inactive"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:fontFamily="@font/sora_regular"
                    android:text="Replied"
                    android:textColor="#B9B2C9"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Thread 1: alex.dev -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_stat_card_dark"
                android:padding="14dp">

                <TextView
                    android:id="@+id/avatarAlex"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/dot_violet"
                    android:gravity="center"
                    android:text="👨‍💻"
                    android:textSize="20sp" />

                <LinearLayout
                    android:id="@+id/metaAlex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_regular"
                        android:text="2m ago"
                        android:textColor="#6B6282"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/dot_unread_blue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/metaAlex"
                    android:layout_toEndOf="@id/avatarAlex"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_semibold"
                        android:text="alex.dev"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/sora_regular"
                        android:singleLine="true"
                        android:text="Amazing project! 🔥"
                        android:textColor="#B9B2C9"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Thread 2: jessica.codes -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_stat_card_dark"
                android:padding="14dp">

                <TextView
                    android:id="@+id/avatarJessica"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/dot_purple"
                    android:gravity="center"
                    android:text="👩‍💻"
                    android:textSize="20sp" />

                <LinearLayout
                    android:id="@+id/metaJessica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_regular"
                        android:text="15m ago"
                        android:textColor="#6B6282"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/dot_unread_blue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/metaJessica"
                    android:layout_toEndOf="@id/avatarJessica"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_semibold"
                        android:text="jessica.codes"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/sora_regular"
                        android:singleLine="true"
                        android:text="When will this be released?"
                        android:textColor="#B9B2C9"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Thread 3: tech_world -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_stat_card_dark"
                android:padding="14dp">

                <TextView
                    android:id="@+id/avatarTech"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/dot_blue"
                    android:gravity="center"
                    android:text="⚡"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/timeTech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/sora_regular"
                    android:text="1h ago"
                    android:textColor="#6B6282"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/timeTech"
                    android:layout_toEndOf="@id/avatarTech"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_semibold"
                        android:text="tech_world"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/sora_regular"
                        android:singleLine="true"
                        android:text="Looks awesome! Keep it up 👍"
                        android:textColor="#B9B2C9"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Thread 4: dev.studio -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_stat_card_dark"
                android:padding="14dp">

                <TextView
                    android:id="@+id/avatarDev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_account_chip_dark"
                    android:gravity="center"
                    android:text="🎨"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/timeDev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/sora_regular"
                    android:text="3h ago"
                    android:textColor="#6B6282"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/timeDev"
                    android:layout_toEndOf="@id/avatarDev"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_semibold"
                        android:text="dev.studio"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/sora_regular"
                        android:singleLine="true"
                        android:text="Can you share the source code?"
                        android:textColor="#B9B2C9"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- Tab 1: Home -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/sora_regular"
                android:text="Home"
                android:textColor="#6B6282"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 2: Calendar -->
        <LinearLayout
            android:id="@+id/tabCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_calender"
                android:contentDescription="Calendar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/sora_regular"
                android:text="Calendar"
                android:textColor="#6B6282"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 3: Create (+) -->
        <FrameLayout
            android:id="@+id/tabCreatePost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_fab_gradient"
                android:contentDescription="Create Post"
                android:padding="10dp"
                android:src="@drawable/ic_nav_add" />
        </FrameLayout>

        <!-- Tab 4: Analytics -->
        <LinearLayout
            android:id="@+id/tabAnalytics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_analytics"
                android:contentDescription="Analytics" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/sora_regular"
                android:text="Analytics"
                android:textColor="#6B6282"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 5: Profile -->
        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_profile"
                android:contentDescription="Profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/sora_regular"
                android:text="Profile"
                android:textColor="#6B6282"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>