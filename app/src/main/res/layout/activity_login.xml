<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_splash_gradient"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp">

        <!-- Socialix Vector Logo -->
        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ic_logo_letter"
            android:contentDescription="Socialix Logo"
            android:scaleType="fitCenter" />

        <!-- Brand Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Socialix"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/sora_bold"
            android:textSize="22sp"
            android:letterSpacing="0.02" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Welcome Back!"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/sora_semibold"
            android:textSize="22sp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Continue growing your audience."
            android:textColor="#B9B2C9"
            android:fontFamily="@font/sora_regular"
            android:textSize="14sp" />

        <!-- Email Field -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_input_box_dark"
            android:hint="Email address"
            android:textColorHint="#6B6282"
            android:textColor="#FFFFFF"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="18dp"
            android:textSize="14sp" />

        <!-- Password Field -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input_box_dark"
            android:hint="Password"
            android:textColorHint="#6B6282"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:paddingHorizontal="18dp"
            android:textSize="14sp" />

        <!-- Options: Remember Me & Forgot Password -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <CheckBox
                android:id="@+id/cbRemember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:buttonTint="#A855F7"
                android:text="Remember me"
                android:textColor="#B9B2C9"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Forgot password?"
                android:textColor="#A855F7"
                android:fontFamily="@font/sora_semibold"
                android:textSize="13sp" />
        </RelativeLayout>

        <!-- Sign In Button (0dp Radius) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSignIn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_gradient_btn"
            android:text="Sign In  →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/sora_semibold"
            android:textSize="16sp" />

        <!-- Divider Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="or continue with"
            android:textColor="#6B6282"
            android:textSize="12sp" />

        <!-- Social Media Buttons Row with Vector Icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Google Button -->
            <FrameLayout
                android:id="@+id/btnGoogle"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_social_box_dark">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_google"
                    android:contentDescription="Google Sign In" />
            </FrameLayout>

            <!-- Apple Button -->
            <FrameLayout
                android:id="@+id/btnApple"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_social_box_dark">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_apple"
                    android:contentDescription="Apple Sign In" />
            </FrameLayout>

            <!-- LinkedIn Button -->
            <FrameLayout
                android:id="@+id/btnLinkedIn"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_social_box_dark">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_linkedin"
                    android:contentDescription="LinkedIn Sign In" />
            </FrameLayout>

        </LinearLayout>

        <!-- Bottom Footer Link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                android:textColor="#B9B2C9"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCreateAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Up"
                android:textColor="#A855F7"
                android:fontFamily="@font/sora_semibold"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>