<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep Midnight Canvas (#0D0B1A) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0B1A" />
        </shape>
    </item>

    <!-- Top-Left Subtle Violet Ambient Glow (Corner Only) -->
    <item
        android:bottom="480dp"
        android:right="180dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="0.0"
                android:gradientRadius="160dp"
                android:startColor="#807C3AED"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Bottom-Right Subtle Blue Ambient Glow (Corner Only) -->
    <item
        android:top="480dp"
        android:left="160dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="1.0"
                android:gradientRadius="170dp"
                android:startColor="#803B82F6"
                android:endColor="#00000000" />
        </shape>
    </item>

</layer-list>