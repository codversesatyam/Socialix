<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- 1. Ambient Glow Behind the S -->
    <path
        android:pathData="M 60,60 Q 100,100 140,140 Q 80,180 50,110 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="80"
                android:startColor="#667C3AED"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- 2. Orbital Ring Path -->
    <path
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M 28,148 C 12,120 40,65 95,48 C 145,33 182,60 178,92 C 174,124 135,164 78,168 C 50,170 32,160 25,148">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="150"
                android:endX="180"
                android:endY="50"
                android:startColor="#8B5CF6"
                android:endColor="#3B82F6" />
        </aapt:attr>
    </path>

    <!-- 3. Bottom-Left Orbiting Sphere -->
    <path
        android:pathData="M 26,150 m -11,0 a 11,11 0 1,0 22,0 a 11,11 0 1,0 -22,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="23"
                android:centerY="147"
                android:gradientRadius="11"
                android:startColor="#93C5FD"
                android:endColor="#2563EB" />
        </aapt:attr>
    </path>

    <!-- 4. Top-Right Orbiting Sphere -->
    <path
        android:pathData="M 172,48 m -8.5,0 a 8.5,8.5 0 1,0 17,0 a 8.5,8.5 0 1,0 -17,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="170"
                android:centerY="46"
                android:gradientRadius="8.5"
                android:startColor="#BAE6FD"
                android:endColor="#0284C7" />
        </aapt:attr>
    </path>

    <!-- 5. Main 3D Ribbon "S" (Gradient Purple to Vibrant Blue) -->
    <path
        android:pathData="M 136,36 C 105,36 82,46 70,68 C 60,86 64,104 84,116 L 118,136 C 132,144 136,152 132,160 C 126,172 108,176 86,172 C 68,168 54,156 46,144 L 32,156 C 44,174 64,188 88,192 C 122,198 152,186 160,158 C 166,136 156,120 134,106 L 102,86 C 88,78 86,70 88,62 C 92,52 108,48 126,50 C 140,52 152,60 160,70 L 174,56 C 164,44 150,36 136,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="40"
                android:startY="180"
                android:endX="160"
                android:endY="40"
                android:startColor="#C084FC"
                android:centerColor="#818CF8"
                android:endColor="#2563EB" />
        </aapt:attr>
    </path>

    <!-- 6. Specular Highlight / Light Curve on Top Loop of 'S' -->
    <path
        android:pathData="M 136,36 C 105,36 82,46 70,68 C 64,79 66,91 76,102 C 72,86 78,70 94,58 C 108,48 126,50 126,50 C 140,52 152,60 160,70 L 174,56 C 164,44 150,36 136,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="70"
                android:startY="70"
                android:endX="150"
                android:endY="40"
                android:startColor="#E9D5FF"
                android:endColor="#818CF8" />
        </aapt:attr>
    </path>

</vector>